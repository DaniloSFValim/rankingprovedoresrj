{
  "name": "@netrank/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:security": "npm audit --audit-level=moderate",
    "analyze": "npm run build && node scripts/analyze-bundle.js"
  },
  "dependencies": {
    "@netrank/core": "*",
    "echarts": "^5.5.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-vitals": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^2.1.0",
    "axe-core": "^4.8.0",
    "axe-playwright": "^1.2.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0"
  }
}

# Variáveis de ambiente do NETRANK RJ.
#
# Nenhuma é necessária para instalar, testar ou compilar o site: os artefatos
# de dados já estão versionados em apps/web/public/data. As variáveis abaixo
# só servem para a ingestão (packages/etl) e para a publicação.
#
# Copie para .env e preencha apenas o que for usar. O arquivo .env está no
# .gitignore e nunca deve ser versionado. Nada aqui é lido pelo navegador.

# --- Ingestão: Base dos Dados (BigQuery), fonte alternativa ------------------
# Conteúdo JSON de uma conta de serviço do Google Cloud com acesso ao BigQuery,
# ou o caminho para o arquivo da chave. Use uma das duas.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Projeto do Google Cloud que paga as consultas.
GOOGLE_CLOUD_PROJECT=exemplo-projeto

# --- Ingestão: catálogo dados.gov.br (opcional) -------------------------------
# Chave gratuita do portal dados.gov.br. Sem ela, a descoberta usa só o
# inventário público da Anatel.
DADOS_GOV_BR_API_KEY=

# --- Ingestão: trava de segurança ---------------------------------------------
# Com "producao", o ETL recusa gerar artefatos a partir de dados demonstrativos.
NETRANK_AMBIENTE=desenvolvimento

# --- Publicação (só no GitHub Actions, como segredos do repositório) ----------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
